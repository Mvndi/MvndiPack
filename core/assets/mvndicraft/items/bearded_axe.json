{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:main_hand",
    "cases": [
      {
        "when": "left",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_false": {
            "type": "minecraft:model",
            "model": "mvndicraft:weapons/axes/bearded_axe_left"
          },
          "on_true": {
            "type": "minecraft:model",
            "model": "mvndicraft:weapons/axes/bearded_axe_throw_left"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "mvndicraft:weapons/axes/bearded_axe"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "mvndicraft:weapons/axes/bearded_axe_throw"
      }
    }
  }
}

{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "none",
        "model": {
          "type": "minecraft:model",
          "model": "mvndicraft:weapons/pole_arms/war_dart_projectile"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:main_hand",
      "cases": [
        {
          "when": "left",
          "model": {
            "type": "model",
            "model": "mvndicraft:weapons/pole_arms/war_dart_left"
          }
        }
      ],
      "fallback": {
        "type": "model",
        "model": "mvndicraft:weapons/pole_arms/war_dart"
      }
    }
  }
}
